# Public site URL used for canonicals, sitemap, schema. Change at domain cutover.
PUBLIC_SITE_URL=https://www.waycoconstruction.com
# Set to "true" ONLY when the domain is live and ready to be indexed. Until then the site is noindex.
PUBLIC_LAUNCH=false
# Google Tag Manager container (GA4, Ads, Meta pixel, etc. are all managed inside GTM)
PUBLIC_GTM_ID=
# Optional: direct GA4 measurement ID if not using GTM
PUBLIC_GA4_ID=
# Search Console verification token (meta tag)
PUBLIC_GSC_VERIFICATION=
# Optional: used by `npm run reviews` to refresh Google reviews (Places API)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJVVVFwUlY2YARx2pZoaG0d1Q
