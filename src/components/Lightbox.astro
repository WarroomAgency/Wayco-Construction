---
import Icon from './Icon.astro';
---
<div id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer" class="fixed inset-0 z-[80] flex flex-col bg-void/95 backdrop-blur" data-pagefind-ignore>
  <div class="flex items-center justify-between p-4 text-silver"><p data-cap class="text-sm"></p><button data-lb-close class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white" aria-label="Close"><Icon name="close" size={22} /></button></div>
  <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 pb-6">
    <button data-lb-prev aria-label="Previous photo" class="absolute left-3 z-10 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"><Icon name="arrow" size={22} class="rotate-180" /></button>
    <img alt="" class="max-h-full max-w-full rounded-lg object-contain" />
    <button data-lb-next aria-label="Next photo" class="absolute right-3 z-10 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"><Icon name="arrow" size={22} /></button>
  </div>
</div>
