---
import { site } from '~/data/site';
---
<div id="consent-banner" hidden role="dialog" aria-label="Cookie consent" aria-live="polite" class="fixed inset-x-3 bottom-3 z-[60] mx-auto max-w-3xl rounded-2xl bg-void p-5 text-white shadow-lift ring-1 ring-white/15 sm:bottom-5 sm:p-6 max-lg:bottom-20" data-pagefind-ignore>
  <p class="font-display text-lg">Your privacy, your call.</p>
  <p class="mt-2 text-[0.9rem] leading-relaxed text-silver">We use cookies to understand how the site is used and to measure our advertising. Essential cookies keep the site working. You can accept, decline or fine-tune — and we honor Global Privacy Control signals. See our <a href="/cookie-policy" class="underline hover:text-white">Cookie Policy</a> and <a href="/privacy-policy" class="underline hover:text-white">Privacy Policy</a>.</p>
  <div class="mt-4 flex flex-wrap gap-2.5">
    <button type="button" data-consent="accept" class="btn btn-primary !py-2.5">Accept all</button>
    <button type="button" data-consent="reject" class="btn btn-ghost-light !py-2.5">Decline non-essential</button>
    <button type="button" data-consent="open" class="btn !py-2.5 text-silver underline-offset-4 hover:text-white hover:underline">Preferences</button>
  </div>
</div>
<div id="consent-prefs" hidden role="dialog" aria-modal="true" aria-labelledby="cp-title" class="fixed inset-0 z-[70] flex items-end justify-center bg-void/70 p-3 backdrop-blur-sm sm:items-center" data-pagefind-ignore>
  <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-3xl bg-white p-6 text-ink shadow-lift sm:p-8">
    <h2 id="cp-title" class="font-display text-2xl">Privacy preferences</h2>
    <p class="mt-2 text-sm text-steel-2">Choose which optional cookies and similar technologies we may use. You can change this anytime from “Your Privacy Choices” in the footer.</p>
    <div class="mt-6 space-y-4">
      <div class="flex items-start justify-between gap-4 rounded-2xl bg-bone p-4"><div><p class="font-semibold">Essential</p><p class="text-sm text-steel-2">Security, form protection and remembering this choice. Always on.</p></div><span class="rounded-full bg-ink px-3 py-1 text-xs font-semibold text-white">Always on</span></div>
      <label class="flex cursor-pointer items-start justify-between gap-4 rounded-2xl bg-bone p-4"><div><p class="font-semibold">Analytics</p><p class="text-sm text-steel-2">Helps us see which pages and projects are useful (Google Analytics).</p></div><input type="checkbox" name="analytics" class="mt-1 h-5 w-5 accent-blue" /></label>
      <label class="flex cursor-pointer items-start justify-between gap-4 rounded-2xl bg-bone p-4"><div><p class="font-semibold">Advertising &amp; measurement</p><p class="text-sm text-steel-2">Lets us measure ad performance and show relevant ads. Disabled automatically if your browser sends a Global Privacy Control signal.</p></div><input type="checkbox" name="marketing" class="mt-1 h-5 w-5 accent-blue" /></label>
    </div>
    <div class="mt-6 flex flex-wrap gap-2.5">
      <button type="button" data-consent="save" class="btn btn-dark">Save preferences</button>
      <button type="button" data-consent="accept" class="btn btn-primary">Accept all</button>
      <button type="button" data-consent="close" class="btn text-steel-2 hover:text-ink">Close</button>
    </div>
  </div>
</div>
