---
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import type { Review } from '~/data/reviews';
interface Props { review: Review; full?: boolean; dark?: boolean }
const { review, full = false, dark = false } = Astro.props;
const initials = review.author.split(' ').map((p) => p[0]).slice(0, 2).join('');
const paras = (full ? review.text : review.excerpt).split(/\n+/).filter(Boolean);
---
<figure class:list={['flex h-full flex-col rounded-3xl p-7 sm:p-8', dark ? 'bg-white/[.06] ring-1 ring-white/10' : 'bg-white shadow-soft ring-1 ring-line/60']}>
  <div class="flex items-center justify-between">
    <Stars size={17} />
    <Icon name="google" size={20} />
  </div>
  <blockquote class:list={['mt-5 flex-1 space-y-3 leading-relaxed', dark ? 'text-silver' : 'text-steel']}>
    {paras.map((p) => <p>{full || !paras.length ? p : `“${p}”`}</p>)}
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-blue text-sm font-semibold text-white">{initials}</span>
    <span class="leading-tight"><span class:list={['block font-semibold', dark ? 'text-white' : 'text-ink']}>{review.author}</span><span class:list={['text-[0.82rem]', dark ? 'text-silver-2' : 'text-steel-2']}>{review.badge ? `${review.badge} · ` : ''}Google review · {review.when}</span></span>
  </figcaption>
</figure>
