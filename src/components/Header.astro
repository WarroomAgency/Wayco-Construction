---
import { Image } from 'astro:assets';
import logo from '~/assets/wayco-logo.png';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site } from '~/data/site';
import { mainNav } from '~/data/nav';
const path = Astro.url.pathname.replace(/\.html$/, '');
const is = (p: string) => path === p || path.startsWith(p + '/');
const link = 'relative px-3 py-2 text-[0.8rem] font-bold uppercase tracking-[0.04em] text-ink transition hover:text-blue after:absolute after:inset-x-3 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-blue after:transition hover:after:scale-x-100';
const mega = 'absolute top-full z-50 pt-4';
---
<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur-xl" data-pagefind-ignore data-section="header">
  <div class="container-x flex items-center justify-between gap-6 py-3">
    <a href="/" class="flex shrink-0 items-center" aria-label="Wayco Construction — home">
      <Image src={logo} alt="Wayco Construction, Inc. logo" height={104} width={194} class="h-[3.25rem] w-auto lg:h-[3.75rem]" loading="eager" />
    </a>

    <div class="hidden flex-col items-end gap-1.5 lg:flex">
      <div class="flex items-center gap-5 text-[0.72rem] font-bold uppercase tracking-[0.06em] text-steel-2">
        <a href="/contact" class="hover:text-blue">Contact us</a>
        <a href="/contact#office" class="hover:text-blue">Our office</a>
        <a href={site.google.reviewsUrl} target="_blank" rel="noopener" data-track="google-review" class="flex items-center gap-1.5 hover:text-blue"><Icon name="google" size={13} /> {site.google.rating}★ · {site.google.reviewCount} reviews</a>
        <a href={site.phoneHref} data-loc="header" class="flex items-center gap-1.5 text-ink hover:text-blue"><Icon name="phone" size={13} /> {site.phone}</a>
        <a href="/search" aria-label="Search the site" class="hover:text-blue"><Icon name="search" size={16} /></a>
      </div>
      <nav aria-label="Primary" class="flex items-center">
        <div class="relative" data-menu>
          <button type="button" data-menu-btn aria-expanded="false" aria-haspopup="true" class:list={[link, 'flex items-center gap-1', is('/commercial') && 'text-blue']}>Commercial <Icon name="chevron" size={13} /></button>
          <div data-menu-panel hidden class:list={[mega, 'left-1/2 w-[min(760px,92vw)] -translate-x-1/2']}>
            <div class="grid grid-cols-[1fr_1fr_1.1fr] gap-8 rounded-2xl border border-line bg-white p-8 shadow-lift">
              {mainNav.commercial.groups.map((g) => (
                <div><p class="eyebrow mb-4">{g.title}</p><ul class="space-y-0.5">{g.links.map((l) => <li><a href={l.href} class="block rounded px-2 py-1.5 text-[0.92rem] text-steel hover:bg-bone hover:text-blue">{l.name}</a></li>)}</ul></div>
              ))}
              <a href="/commercial" class="group relative overflow-hidden rounded-xl bg-void text-white">
                <Photo name="humphry-s-pool-bar-gallery-14-1" alt="" class="absolute inset-0 h-full w-full transition duration-700 group-hover:scale-105" sizes="320px" widths={[320, 640]} />
                <div class="relative flex h-full min-h-[220px] flex-col justify-end bg-gradient-to-t from-void/90 to-transparent p-5"><p class="font-display text-lg !text-white">Commercial &amp; hospitality</p><span class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold">See commercial work <Icon name="arrow" size={15} /></span></div>
              </a>
            </div>
          </div>
        </div>
        <div class="relative" data-menu>
          <button type="button" data-menu-btn aria-expanded="false" aria-haspopup="true" class:list={[link, 'flex items-center gap-1', (is('/residential') || is('/adu-construction')) && 'text-blue']}>Residential &amp; ADUs <Icon name="chevron" size={13} /></button>
          <div data-menu-panel hidden class:list={[mega, 'left-1/2 w-[min(640px,92vw)] -translate-x-1/2']}>
            <div class="grid grid-cols-[1fr_1.1fr] gap-8 rounded-2xl border border-line bg-white p-8 shadow-lift">
              <div><p class="eyebrow mb-4">Residential services</p><ul class="space-y-0.5">{mainNav.residential.groups[0].links.map((l) => <li><a href={l.href} class="block rounded px-2 py-1.5 text-[0.92rem] text-steel hover:bg-bone hover:text-blue">{l.name}</a></li>)}</ul></div>
              <a href="/adu-construction" class="group relative overflow-hidden rounded-xl bg-void text-white">
                <Photo name="elliot-adu-gallery-05" alt="" class="absolute inset-0 h-full w-full transition duration-700 group-hover:scale-105" sizes="320px" widths={[320, 640]} />
                <div class="relative flex h-full min-h-[240px] flex-col justify-end bg-gradient-to-t from-void/90 to-transparent p-5"><p class="text-eyebrow uppercase tracking-widest text-silver">Featured</p><p class="mt-1 font-display text-lg !text-white">Turnkey ADUs from {site.aduPriceRange.label.split('–')[0]}</p><span class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold">Explore ADUs <Icon name="arrow" size={15} /></span></div>
              </a>
            </div>
          </div>
        </div>
        <div class="relative" data-menu>
          <button type="button" data-menu-btn aria-expanded="false" aria-haspopup="true" class:list={[link, 'flex items-center gap-1', is('/projects') && 'text-blue']}>Our work <Icon name="chevron" size={13} /></button>
          <div data-menu-panel hidden class:list={[mega, 'left-0 w-60']}>
            <ul class="rounded-2xl border border-line bg-white p-3 shadow-lift">{mainNav.work.map((l) => <li><a href={l.href} class="block rounded px-3 py-2 text-[0.92rem] text-steel hover:bg-bone hover:text-blue">{l.name}</a></li>)}</ul>
          </div>
        </div>
        <div class="relative" data-menu>
          <button type="button" data-menu-btn aria-expanded="false" aria-haspopup="true" class:list={[link, 'flex items-center gap-1', (is('/about') || is('/meet-the-team') || is('/reviews')) && 'text-blue']}>Company <Icon name="chevron" size={13} /></button>
          <div data-menu-panel hidden class:list={[mega, 'left-0 w-56']}>
            <ul class="rounded-2xl border border-line bg-white p-3 shadow-lift">{mainNav.company.map((l) => <li><a href={l.href} class="block rounded px-3 py-2 text-[0.92rem] text-steel hover:bg-bone hover:text-blue">{l.name}</a></li>)}</ul>
          </div>
        </div>
        <a href="/blog" class:list={[link, is('/blog') && 'text-blue']}>News &amp; insights</a>
        <a href="/request-consultation" data-track="cta" data-loc="header" class="btn btn-primary ml-3 !rounded-md !px-5 !py-2.5 text-[0.8rem] font-bold uppercase tracking-[0.05em]">Free consultation</a>
      </nav>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <a href={site.phoneHref} aria-label={`Call ${site.phone}`} data-loc="header-mobile" class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink"><Icon name="phone" size={19} /></a>
      <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu" class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink"><Icon name="menu" size={22} /></button>
    </div>
  </div>
</header>

<div id="mobile-nav" hidden class="fixed inset-0 top-[4.75rem] z-40 overflow-y-auto bg-white lg:hidden" data-pagefind-ignore>
  <div class="container-x space-y-2 py-6 pb-32">
    <p class="eyebrow">Commercial</p>
    <a href="/commercial" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">Commercial &amp; hospitality overview</a>
    <details class="rounded-xl bg-bone px-4 py-1"><summary class="flex cursor-pointer items-center justify-between py-3 font-display text-lg">Commercial services <Icon name="chevron" size={18} /></summary><ul class="pb-3">{[...mainNav.commercial.groups[0].links, ...mainNav.commercial.groups[1].links].map((l) => <li><a href={l.href} class="block py-2 text-steel-2">{l.name}</a></li>)}</ul></details>
    <p class="eyebrow pt-4">Residential</p>
    <a href="/residential" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">Residential &amp; ADUs overview</a>
    <details class="rounded-xl bg-bone px-4 py-1"><summary class="flex cursor-pointer items-center justify-between py-3 font-display text-lg">Residential services <Icon name="chevron" size={18} /></summary><ul class="pb-3">{mainNav.residential.groups[0].links.map((l) => <li><a href={l.href} class="block py-2 text-steel-2">{l.name}</a></li>)}</ul></details>
    <p class="eyebrow pt-4">Explore</p>
    <a href="/projects" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">Our work</a>
    <a href="/reviews" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">Google reviews</a>
    <a href="/about" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">About &amp; team</a>
    <a href="/serving-area" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">Areas we serve</a>
    <a href="/blog" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">News &amp; insights</a>
    <a href="/search" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">Search</a>
    <a href="/contact" class="block rounded-xl bg-bone px-4 py-4 font-display text-lg">Contact</a>
    <div class="grid gap-3 pt-4"><a href="/request-consultation" class="btn btn-primary" data-track="cta" data-loc="mobile-nav">Free consultation</a><a href={site.phoneHref} class="btn btn-ghost" data-loc="mobile-nav"><Icon name="phone" size={18} /> {site.phone}</a></div>
  </div>
</div>
