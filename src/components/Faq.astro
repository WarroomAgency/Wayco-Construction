---
import Icon from './Icon.astro';
interface Props { faqs: { q: string; a: string }[]; title?: string; eyebrow?: string; dark?: boolean }
const { faqs, title = 'Frequently asked questions', eyebrow = 'FAQ', dark = false } = Astro.props;
---
<div>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="font-display text-display-md">{title}</h2>
  <div class="mt-8 divide-y divide-line rounded-3xl bg-white ring-1 ring-line/70">
    {faqs.map((f) => (
      <details class="group px-6 py-1 sm:px-8">
        <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 text-left font-display text-lg leading-snug sm:text-xl">
          <span>{f.q}</span>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-bone text-ink transition group-open:rotate-45 group-open:bg-blue group-open:text-white"><Icon name="plus" size={18} /></span>
        </summary>
        <p class="max-w-3xl pb-6 leading-relaxed text-steel-2">{f.a}</p>
      </details>
    ))}
  </div>
</div>
