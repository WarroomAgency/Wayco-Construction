---
import { getImage } from 'astro:assets';
import { site } from '~/data/site';
import { photo } from '~/lib/photos';
import { abs, clamp } from '~/lib/seo';
interface Props {
  title: string;
  description: string;
  path?: string;
  ogPhoto?: string;      // photo key
  ogType?: 'website' | 'article';
  noindex?: boolean;
  published?: string;
  modified?: string;
  fullTitle?: boolean;   // don't append brand
}
const { title, description, path = Astro.url.pathname, ogPhoto, ogType = 'website', noindex = false, published, modified, fullTitle = false } = Astro.props;
// Append the brand only when it keeps the <title> within ~62 chars (SERP truncation), so keyword-rich titles are never cut mid-phrase.
const withLong = `${title} | Wayco Construction`, withShort = `${title} | Wayco`;
const finalTitle = fullTitle || /wayco/i.test(title) ? title : withLong.length <= 62 ? withLong : withShort.length <= 62 ? withShort : title;
const canonical = abs(path === '' ? '/' : path.replace(/\/$/, '') || '/');
let og = abs(site.ogDefault);
if (ogPhoto) {
  const img = await getImage({ src: photo(ogPhoto), width: 1200, height: 630, format: 'jpg', quality: 80, fit: 'cover' } as any);
  og = abs(img.src);
}
const robots = noindex || !site.launched ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<title>{finalTitle}</title>
<meta name="description" content={clamp(description, 160)} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={clamp(description, 200)} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={finalTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={clamp(description, 200)} />
<meta name="twitter:image" content={og} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
{site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
<meta name="geo.region" content="US-CA" />
<meta name="geo.placename" content="El Cajon" />
<meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
<meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
