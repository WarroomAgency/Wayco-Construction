---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import type { Service } from '~/data/types';
interface Props { service: Service }
const { service } = Astro.props;
---
<a href={`/${service.slug}`} class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-line/60 transition hover:-translate-y-1 hover:shadow-lift">
  <div class="overflow-hidden"><Photo name={service.heroPhoto} alt={`${service.name} by Wayco Construction`} ratio="16/10" class="w-full transition duration-700 group-hover:scale-105" sizes="(min-width:1024px) 30vw, 90vw" widths={[400, 700, 1000]} /></div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-xl leading-snug">{service.name}</h3>
    <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-steel-2">{service.summary}</p>
    <span class="link-arrow mt-4 text-sm">Learn more <Icon name="arrow" size={16} /></span>
  </div>
</a>
