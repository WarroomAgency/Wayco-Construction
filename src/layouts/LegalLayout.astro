---
import BaseLayout from './BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import { breadcrumbNode } from '~/lib/seo';
interface Props { title: string; description: string; path: string; updated: string }
const { title, description, path, updated } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} schema={[breadcrumbNode([{ name: 'Home', path: '/' }, { name: title, path }])]} pagefind={false}>
  <section class="bg-void py-16 text-white sm:py-24"><div class="container-n"><p class="eyebrow !text-silver">Legal</p><h1 class="mt-3 font-display text-display-lg !text-white">{title}</h1><p class="mt-3 text-silver">Last updated {updated}</p></div></section>
  <section class="section"><div class="container-n"><div class="prose-wayco"><slot /></div></div></section>
</BaseLayout>
