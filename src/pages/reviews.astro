---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ReviewCard from '~/components/ReviewCard.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import AnswerBox from '~/components/AnswerBox.astro';
import { reviews } from '~/data/reviews';
import { site } from '~/data/site';
import { breadcrumbNode } from '~/lib/seo';
const filters = [['all', 'All'], ['kitchen', 'Kitchens'], ['bathroom', 'Bathrooms'], ['remodel', 'Major remodels'], ['commercial', 'Commercial'], ['property', 'Property managers'], ['rebuild', 'Rebuilds']];
---
<BaseLayout title="Google Reviews — Wayco Construction El Cajon" description={`${site.google.rating} stars from ${site.google.reviewCount} Google reviews. Read what homeowners, property managers and architects say about Wayco Construction in El Cajon, CA.`} path="/reviews" ogPhoto="reviews" schema={[breadcrumbNode([{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews' }])]}>
  <PageHero eyebrow="Reviews" h1="What clients say about working with Wayco" lead="Real Google reviews from homeowners, property managers, architects and engineers — unedited, with owner replies." photo="additional-photos-remodel-gallery-02" crumbs={[{ name: 'Reviews' }]} cta={false} compact />
  <section class="section">
    <div class="container-x">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_1.4fr]">
        <div class="rounded-3xl bg-ink p-8 text-white sm:p-10">
          <p class="eyebrow !text-silver">Google rating</p>
          <p class="mt-3 font-display text-7xl text-white">{site.google.rating.toFixed(1)}<span class="text-3xl text-silver">/5</span></p>
          <p class="mt-2 text-silver">Based on {site.google.reviewCount} Google reviews</p>
          <div class="mt-6 flex flex-wrap gap-3"><a href={site.google.reviewsUrl} target="_blank" rel="noopener" class="btn btn-primary" data-track="google-review" data-dest="all">Read on Google <Icon name="arrow-ur" size={16} /></a><a href={site.google.writeReviewUrl} target="_blank" rel="noopener" class="btn btn-ghost-light" data-track="google-review" data-dest="write">Write a review</a></div>
        </div>
        <AnswerBox label="What reviewers mention most" text="Clients most often praise Wayco’s communication, clear schedules, professionalism, craftsmanship and fair pricing on kitchen, bathroom and whole-home remodels, rebuilds and commercial build-outs — and the speed of warranty response." />
      </div>
      <div data-filter-group=".review-item" class="mt-12 flex flex-wrap gap-2" role="group" aria-label="Filter reviews">
        {filters.map(([k, l], i) => <button type="button" data-filter={k} aria-pressed={i === 0 ? 'true' : 'false'} class="rounded-full border border-ink/15 bg-white px-5 py-2.5 text-sm font-semibold transition hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white">{l}</button>)}
      </div>
      <div class="mt-8 columns-1 gap-5 md:columns-2 lg:columns-3 [&>*]:mb-5">
        {reviews.map((r) => (
          <div class="review-item break-inside-avoid" data-cats={r.tags.join(' ')}>
            <ReviewCard review={r} full />
            {r.response && <p class="mt-2 px-2 text-sm text-steel-2"><strong>Owner reply:</strong> {r.response}</p>}
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-3xl text-sm text-steel-2">Reviews shown are a selection of verified Google reviews, reproduced verbatim. The complete, unfiltered list — including every rating — is on our <a class="underline" href={site.google.reviewsUrl} target="_blank" rel="noopener">Google Business Profile</a>.</p>
    </div>
  </section>
  <CtaBand title="Join our list of happy clients" />
</BaseLayout>
