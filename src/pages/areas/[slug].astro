---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import AnswerBox from '~/components/AnswerBox.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import SectionHead from '~/components/SectionHead.astro';
import Faq from '~/components/Faq.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { areas } from '~/data/areas';
import { serviceBySlug } from '~/data/services';
import { breadcrumbNode, faqNode, abs, ids } from '~/lib/seo';
export const getStaticPaths = (() => areas.map((area) => ({ params: { slug: area.slug }, props: { area } }))) satisfies GetStaticPaths;
const { area: a } = Astro.props;
const svcs = a.topServices.map((s) => serviceBySlug[s]).filter(Boolean);
const near = a.nearby.map((n) => areas.find((x) => x.slug === n)).filter(Boolean);
const url = abs(`/areas/${a.slug}`);
const svcNode = { '@type': 'Service', '@id': `${url}#service`, name: `General contractor services in ${a.name}, CA`, serviceType: 'General contractor', provider: { '@id': ids.business }, areaServed: { '@type': 'City', name: a.name, ...(a.geo ? { geo: { '@type': 'GeoCoordinates', latitude: a.geo.lat, longitude: a.geo.lng } } : {}), containedInPlace: { '@type': 'AdministrativeArea', name: `${a.county}, CA` } }, url };
const page = { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: a.seoTitle, description: a.metaDescription, isPartOf: { '@id': ids.site }, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['[data-answer]', 'h1'] } };
---
<BaseLayout title={a.seoTitle} description={a.metaDescription} path={`/areas/${a.slug}`} ogPhoto={a.heroPhoto} schema={[page, svcNode, breadcrumbNode([{ name: 'Home', path: '/' }, { name: 'Areas We Serve', path: '/serving-area' }, { name: a.name, path: `/areas/${a.slug}` }]), faqNode(a.localFaqs)]}>
  <PageHero eyebrow={`${a.name}, CA`} h1={a.h1} lead={a.driveFromShop} photo={a.heroPhoto} photoAlt={`Remodeling and construction in ${a.name}, California`} crumbs={[{ name: 'Areas We Serve', path: '/serving-area' }, { name: a.name }]} chips={['Family-owned', '1-year workmanship warranty', 'Free consultation']} />
  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div class="space-y-8">
        <AnswerBox text={a.answer} />
        <div class="space-y-5 text-lg leading-relaxed text-steel">{a.intro.map((p) => <p>{p}</p>)}</div>
        <div class="rounded-3xl bg-bone-2 p-7 ring-1 ring-line/60"><h2 class="font-display text-2xl">Building in {a.name}: what to know</h2><p class="mt-3 leading-relaxed text-steel">{a.housingNotes}</p></div>
        <div><h2 class="font-display text-2xl">Neighborhoods we serve in {a.name}</h2><ul class="mt-4 flex flex-wrap gap-2">{a.neighborhoods.map((n) => <li class="flex items-center gap-1.5 rounded-full bg-white px-4 py-2 text-[0.92rem] shadow-soft ring-1 ring-line/60"><Icon name="pin" size={14} class="text-blue" />{n}</li>)}</ul></div>
        <ReviewBadge />
      </div>
      <aside class="lg:sticky lg:top-28"><QuoteForm id="area" compact title={`Start your ${a.name} project`} /></aside>
    </div>
  </section>
  <section class="section bg-bone-2" data-section="services">
    <div class="container-x"><SectionHead eyebrow={`Popular in ${a.name}`} title={`Services for ${a.name} homes and businesses`} /><div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{svcs.map((s) => <div class="reveal"><ServiceCard service={s} /></div>)}</div></div>
  </section>
  <section class="section"><div class="container-n"><Faq faqs={a.localFaqs} title={`Building in ${a.name}: your questions`} eyebrow={`${a.name} FAQ`} /></div></section>
  {near.length > 0 && <section class="section bg-bone-2 pt-14"><div class="container-x"><SectionHead eyebrow="Nearby" title="We also serve" /><ul class="mt-8 flex flex-wrap gap-3">{near.map((n) => <li><a href={`/areas/${n!.slug}`} class="btn btn-ghost">{n!.name}</a></li>)}<li><a href="/serving-area" class="btn btn-dark">All areas</a></li></ul></div></section>}
  <CtaBand title={`Planning a project in ${a.name}?`} photo={a.heroPhoto} />
</BaseLayout>
