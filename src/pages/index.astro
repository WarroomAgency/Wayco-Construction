---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Photo from '~/components/Photo.astro';
import Icon from '~/components/Icon.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import ReviewCard from '~/components/ReviewCard.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import SectionHead from '~/components/SectionHead.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import LogoWall from '~/components/LogoWall.astro';
import Steps from '~/components/Steps.astro';
import { site } from '~/data/site';
import { residential, commercial, serviceBySlug } from '~/data/services';
import { featuredProjects, projectBySlug } from '~/data/projects';
import { featuredReviews } from '~/data/reviews';
import { areas } from '~/data/areas';
import { homeFaqs } from '~/data/faqs';
import { team } from '~/data/team';
import { faqNode } from '~/lib/seo';

const featuredServices = ['adu-construction', 'kitchen-remodeling', 'bathroom-remodeling', 'whole-home-renovation', 'home-additions', 'custom-home-construction'].map((s) => serviceBySlug[s]);
const projects = ['elliot-adu', 'kitchen-remodel-portfolio', 'humphreys-pool-bar', 'bathroom-remodel-portfolio', 'pauma-casino', 'hotel-projects'].map((s) => projectBySlug[s]);
const josh = team[0];
const aduIncluded = ['County pre-approved design plans', 'Full engineering', 'Complete construction', 'Appliances & fixtures', 'Turnkey, move-in ready'];
const startSteps = [
  { title: 'Free consultation & walkthrough', text: 'We visit the property, listen to your goals and budget, and tell you plainly what’s feasible.' },
  { title: 'Design & submittals · weeks 1–2', text: 'Plans, engineering and permit submittals prepared in-house so nothing waits on a handoff.' },
  { title: 'Procurement · week 3', text: 'Materials ordered and scheduled — with showroom pricing on finishes — before we mobilize.' },
  { title: 'Mobilize & build · week 4 on', text: 'Your superintendent and project manager keep the schedule, the site and your inbox in order.' },
];
const stats = [
  { v: '25+', l: 'Years of construction experience' },
  { v: `${site.google.rating.toFixed(1)}★`, l: `${site.google.reviewCount} Google reviews` },
  { v: '1-Year', l: 'Workmanship warranty' },
  { v: '~4 wks', l: 'Typical time to project start' },
];
const why = [
  { icon: 'layers', t: 'One team, one contract', d: 'Design, engineering, permitting and construction under a single point of accountability — no finger-pointing between a designer and a builder.' },
  { icon: 'file', t: 'Permits handled', d: 'We prepare and manage all required permitting and inspections, so you aren’t left decoding city and county requirements.' },
  { icon: 'users', t: 'Real communication', d: 'Clients consistently tell us the same thing: they always knew what was happening next. A dedicated PM and superintendent keep you in the loop.' },
  { icon: 'shield', t: 'A warranty that’s honored', d: 'Every project carries a 1-year workmanship warranty — and past clients specifically note how quickly we respond.' },
];
const webPage = {
  '@type': 'WebPage',
  '@id': `${site.url}/#webpage`,
  url: site.url,
  name: 'Wayco Construction | Design-Build General Contractor in El Cajon & San Diego County',
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#localbusiness` },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.url}${site.ogDefault}` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['[data-answer]', 'h1'] },
};
const video = {
  '@type': 'VideoObject',
  name: 'Wayco Construction — design-build general contractor, El Cajon CA',
  description: 'A look at the homes, ADUs and commercial spaces built by Wayco Construction in San Diego County.',
  thumbnailUrl: `${site.url}/images/video-poster.jpg`,
  uploadDate: '2025-01-01',
  contentUrl: `${site.url}/video/wayco-reel.mp4`,
};
---
<BaseLayout
  title="Wayco Construction | ADU & General Contractor in El Cajon, CA"
  fullTitle
  description="Family-owned design-build contractor in El Cajon serving San Diego County. ADUs, kitchen & bath remodels, custom homes and commercial builds. 1-year warranty. Free consultation."
  path="/"
  ogPhoto="residential-hero"
  schema={[webPage, video, faqNode(homeFaqs)]}
>
  <!-- HERO -->
  <section class="on-dark relative isolate overflow-hidden bg-void text-white" data-section="hero">
    <video class="absolute inset-0 -z-20 h-full w-full object-cover opacity-90" autoplay muted loop playsinline preload="metadata" poster="/images/video-poster.jpg" aria-hidden="true" id="hero-video">
      <source src="/video/wayco-reel.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-void/95 via-void/70 to-void/20"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-void/80 via-transparent to-void/30"></div>
    <div class="container-x grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.25fr_1fr] lg:py-28">
      <div class="animate-fade-up">
        <div class="flex flex-wrap items-center gap-3"><ReviewBadge dark /><span class="rounded-full bg-white/10 px-4 py-2 text-[0.82rem] text-silver ring-1 ring-white/15">Family-owned · El Cajon, CA</span></div>
        <h1 class="mt-7 font-display text-hero !text-white">Design-build contractor for San Diego County homes &amp; businesses.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-silver sm:text-xl">ADUs, kitchen and bath remodels, whole-home renovations, custom homes and commercial build-outs — designed, permitted and built by one accountable team, backed by a 1-year workmanship warranty.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/request-consultation" class="btn btn-primary text-base" data-track="cta" data-loc="hero">Get a Free Consultation <Icon name="arrow" size={18} /></a>
          <a href="/projects" class="btn btn-ghost-light text-base" data-track="cta" data-loc="hero">See Our Work</a>
        </div>
        <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-[0.92rem] text-silver">
          {['Permits handled', 'Free consultations', 'Projects typically start within ~4 weeks'].map((t) => <li class="flex items-center gap-2"><Icon name="check" size={16} class="text-blue-hi" />{t}</li>)}
        </ul>
      </div>
      <div class="hidden lg:block animate-fade-up [animation-delay:150ms]"><QuoteForm id="hero" compact dark title="Free project consultation" sub="Tell us what you’re planning. We’ll call you within one business day." /></div>
    </div>
  </section>

  <!-- ANSWER + STATS -->
  <section class="section pb-10 sm:pb-14">
    <div class="container-x grid items-start gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div class="reveal">
        <p class="eyebrow mb-4">Who we are</p>
        <h2 class="font-display text-display-lg">A San Diego County general contractor that treats your project like it’s the only one.</h2>
        <p data-answer class="mt-6 text-lg leading-relaxed text-steel">Wayco Construction, Inc. is a family-owned design-build general contractor based in El Cajon, California. We design, permit and build ADUs, kitchen and bathroom remodels, whole-home renovations, custom homes, tenant improvements and commercial projects across San Diego County, with more than 25 years of leadership experience, a 1-year workmanship warranty and free consultations.</p>
        <div class="mt-7 flex flex-wrap gap-4"><a href="/about" class="link-arrow">Our story <Icon name="arrow" size={16} /></a><a href="/meet-the-team" class="link-arrow">Meet the team <Icon name="arrow" size={16} /></a></div>
      </div>
      <dl class="reveal grid grid-cols-2 gap-4">
        {stats.map((s) => <div class="rounded-3xl bg-white p-6 shadow-soft ring-1 ring-line/60"><dt class="font-display text-4xl text-blue sm:text-5xl">{s.v}</dt><dd class="mt-2 text-[0.9rem] leading-snug text-steel-2">{s.l}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" data-section="services">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead eyebrow="What we build" title="Residential work, done the way you’d do it for family." text="From a single kitchen to a ground-up ADU, every project gets a written scope, a clear schedule and one person who answers your calls." />
        <a href="/adu-construction" class="link-arrow">All services &amp; ADUs <Icon name="arrow" size={16} /></a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredServices.map((s) => <div class="reveal"><ServiceCard service={s} /></div>)}
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <a href="/exterior-improvements" class="group reveal flex items-center justify-between gap-4 rounded-3xl bg-bone-2 p-6 ring-1 ring-line/60 transition hover:bg-white"><span><span class="eyebrow">Also</span><span class="mt-1 block font-display text-xl">Exteriors, outdoor living, garages &amp; more</span></span><Icon name="arrow" size={22} class="shrink-0 text-blue transition group-hover:translate-x-1" /></a>
        <a href="/commercial-construction" class="group reveal flex items-center justify-between gap-4 rounded-3xl bg-ink p-6 text-white transition hover:bg-steel"><span><span class="eyebrow !text-silver">Commercial</span><span class="mt-1 block font-display text-xl !text-white">Tenant improvements, hospitality, multi-family &amp; ground-up</span></span><Icon name="arrow" size={22} class="shrink-0 text-blue-hi transition group-hover:translate-x-1" /></a>
      </div>
    </div>
  </section>

  <!-- ADU FEATURE -->
  <section class="on-dark relative isolate my-6 overflow-hidden bg-void py-20 text-white sm:py-28" data-section="adu">
    <Photo name="model-e-adu-gallery-02" alt="" class="absolute inset-0 -z-20 h-full w-full opacity-30" sizes="100vw" widths={[800, 1400, 2000]} />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-void via-void/90 to-void/60"></div>
    <div class="container-x grid items-center gap-14 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow mb-4 !text-silver">Turnkey ADU packages</p>
        <h2 class="font-display text-display-lg !text-white">Turn your backyard into a finished home.</h2>
        <p class="mt-5 text-lg leading-relaxed text-silver">Our ground-up ADU packages are priced from {site.aduPriceRange.label.split('–')[0]} and run up to {site.aduPriceRange.label.split('–')[1]} for our 1,200 sq ft, 2-bedroom, 1-bath flagship — one contract covering design, engineering, permits and construction. Final pricing depends on site conditions, utilities and finishes.</p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">{aduIncluded.map((i) => <li class="flex items-center gap-3"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue text-white"><Icon name="check" size={15} /></span>{i}</li>)}</ul>
        <div class="mt-9 flex flex-wrap gap-3"><a href="/adu-construction" class="btn btn-primary" data-track="cta" data-loc="adu-feature">Explore our ADUs <Icon name="arrow" size={18} /></a><a href="/projects/adu-model-plans" class="btn btn-ghost-light">View model plans A–E</a></div>
      </div>
      <div class="reveal grid grid-cols-2 gap-4">
        <Photo name="elliot-adu-gallery-05" alt="Kitchen and entry of a finished ADU built by Wayco Construction" ratio="3/4" class="w-full rounded-3xl" sizes="(min-width:1024px) 22vw, 45vw" widths={[400, 700, 1000]} />
        <Photo name="walker-adu-gallery-02" alt="Hardwood-floored living space in a Wayco-built ADU" ratio="3/4" class="mt-10 w-full rounded-3xl" sizes="(min-width:1024px) 22vw, 45vw" widths={[400, 700, 1000]} />
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section" data-section="process">
    <div class="container-x">
      <SectionHead eyebrow="How it works" title="From first call to first day on site in about four weeks." text="Speed comes from doing design, engineering and procurement in parallel — not from cutting corners." />
      <div class="mt-12"><Steps steps={startSteps} /></div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section bg-bone-2" data-section="projects">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead eyebrow="Selected work" title="Residential craft. Commercial scale." text="Kitchens, baths and ADUs for homeowners — and casinos, hotels, airports and medical offices for owners who can’t afford surprises." />
        <a href="/projects" class="link-arrow">Full portfolio <Icon name="arrow" size={16} /></a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{projects.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}</div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="on-dark bg-ink py-20 text-white sm:py-28" data-section="reviews">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHead dark eyebrow="Google reviews" title="What our clients say — in their own words." />
        <div class="flex flex-col items-start gap-3 sm:items-end"><ReviewBadge dark /><a href="/reviews" class="link-arrow !text-white">Read all reviews <Icon name="arrow" size={16} /></a></div>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featuredReviews.slice(0, 6).map((r) => <div class="reveal"><ReviewCard review={r} dark /></div>)}
      </div>
      <div class="mt-10 flex flex-wrap gap-3"><a href={site.google.writeReviewUrl} target="_blank" rel="noopener" class="btn btn-ghost-light" data-track="google-review" data-dest="write">Leave us a Google review</a></div>
    </div>
  </section>

  <!-- WHY WAYCO + TEAM -->
  <section class="section" data-section="why">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[1fr_1.15fr]">
      <div class="reveal relative">
        <Photo name={josh.photo} alt="Josh Coit, President of Wayco Construction" ratio="4/5" class="w-full rounded-[2rem]" sizes="(min-width:1024px) 40vw, 90vw" widths={[500, 800, 1100]} />
        <div class="absolute -bottom-6 -right-2 max-w-[17rem] rounded-2xl bg-ink p-5 text-white shadow-lift sm:-right-6"><p class="font-display text-xl leading-snug !text-white">Josh Coit</p><p class="mt-1 text-sm text-silver">President · 25+ years in design-build &amp; construction management</p></div>
      </div>
      <div>
        <SectionHead eyebrow="Why Wayco" title="Built on communication, craftsmanship and follow-through." />
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {why.map((w) => <div class="reveal"><span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-soft text-blue"><Icon name={w.icon} size={22} /></span><h3 class="mt-4 font-display text-xl">{w.t}</h3><p class="mt-2 leading-relaxed text-steel-2">{w.d}</p></div>)}
        </div>
        <a href="/meet-the-team" class="btn btn-dark mt-10">Meet the team <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="section bg-bone-2 pt-16" data-section="areas">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <SectionHead eyebrow="Where we build" title="Based in El Cajon. Building across San Diego County." text="Our office and showroom (by appointment) are at 1069 Graves Ave. We regularly build in these communities and beyond." />
      <ul class="reveal flex flex-wrap gap-2.5">
        {areas.map((a) => <li><a href={`/areas/${a.slug}`} class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-[0.95rem] font-medium shadow-soft ring-1 ring-line/60 transition hover:bg-blue hover:text-white"><Icon name="pin" size={15} />{a.name}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="section py-14" aria-label="Material and building partners">
    <div class="container-x"><p class="eyebrow mb-8 text-center">Trusted material &amp; building partners</p><LogoWall /></div>
  </section>

  <!-- FAQ -->
  <section class="section pt-6" data-section="faq">
    <div class="container-n"><Faq faqs={homeFaqs} title="Questions we hear every week" /><p class="mt-6 text-center"><a href="/faqs" class="link-arrow">See all FAQs <Icon name="arrow" size={16} /></a></p></div>
  </section>

  <CtaBand />

  <script is:inline>
    (function () {
      var v = document.getElementById('hero-video'); if (!v) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches, save = navigator.connection && navigator.connection.saveData;
      if (reduce || save) { v.removeAttribute('autoplay'); v.pause(); v.querySelectorAll('source').forEach(function (s) { s.remove(); }); v.load(); }
    })();
  </script>
</BaseLayout>
