---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import { faqGroups } from '~/data/faqs';
import { faqNode, breadcrumbNode } from '~/lib/seo';
const all = faqGroups.flatMap((g) => g.faqs);
---
<BaseLayout title="FAQs — ADUs, Remodeling, Permits & Pricing" description="Answers to common questions about ADUs, remodeling costs and timelines, permits, warranties and commercial projects with Wayco Construction in El Cajon, CA." path="/faqs" ogPhoto="inc-hero-project-planning-services" schema={[faqNode(all), breadcrumbNode([{ name: 'Home', path: '/' }, { name: 'FAQs', path: '/faqs' }])]}>
  <PageHero eyebrow="FAQ" h1="Frequently asked questions" lead="Straight answers about working with Wayco Construction — from your first consultation to the final walkthrough." photo="inc-hero-project-planning-services" crumbs={[{ name: 'FAQs' }]} cta={false} compact />
  <section class="section">
    <div class="container-n">
      <nav aria-label="FAQ topics" class="mb-14 flex flex-wrap gap-2">{faqGroups.map((g) => <a href={`#${g.id}`} class="rounded-full border border-ink/15 bg-white px-5 py-2.5 text-sm font-semibold hover:border-ink">{g.title}</a>)}</nav>
      <div class="space-y-16">{faqGroups.map((g) => <div id={g.id}><Faq faqs={g.faqs} title={g.title} eyebrow="" /></div>)}</div>
    </div>
  </section>
  <CtaBand title="Didn’t find your answer?" text="Call or send us a note — a real person will get back to you, usually within one business day." />
</BaseLayout>
